# Copy this file to .env and fill in the values you need.
# Nothing here is required for local development — sensible defaults are
# used automatically (SQLite database, mock AI provider, local file storage).

# --- Database -----------------------------------------------------------
# SQLite by default. To use PostgreSQL in production, change the
# `datasource` provider in prisma/schema.prisma to "postgresql" and point
# this at a Postgres connection string, then run `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Required in production (the app refuses to start sessions without it).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# --- AI provider ------------------------------------------------------
# Leave unset to use the built-in MockProvider (deterministic, free, no
# network calls) — the whole app works end-to-end without this.
# OPENAI_API_KEY="sk-..."
# OPENAI_TEXT_MODEL="gpt-4o-mini"
# OpenAI retired the dall-e-3/2 image API — gpt-image-1 is the only image model
# left. Required if OPENAI_API_KEY is set; there is no working default.
# OPENAI_IMAGE_MODEL="gpt-image-1"

# --- Local/free image generation (alternative to OpenAI) ------------------
# Points at a local AUTOMATIC1111 Stable Diffusion WebUI (run with --api).
# Used only when OPENAI_API_KEY is unset. Only reachable from your own
# machine — never set this on a deployed/hosted environment.
# SD_WEBUI_URL="http://127.0.0.1:7860"

# --- Internal job continuation ---------------------------------------------
# Required in production. Book generation can outlast one serverless
# invocation's time limit; the job hands itself off to a new invocation via
# POST /api/jobs/:id/continue, an unauthenticated server-to-server endpoint
# gated by this shared secret. Generate one with: openssl rand -base64 32
INTERNAL_JOB_SECRET=""

# --- File storage ---------------------------------------------------------
# None. Exported PDFs are rendered in memory per request and streamed
# straight to the browser as a download — the app never writes generated
# books to disk, S3, or the database.
